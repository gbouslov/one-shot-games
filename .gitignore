node_modules/
dist/
.vite/
# Everything a run generates: screenshots, video, reports.
**/playtest/
**/shots/
**/capture/
**/video/
*.log
.DS_Store
# Cloned sources read during audits; never committed.
.scratch/
# Audit evidence is committed as small JPEGs; full-size PNG captures stay local.
references/audit/**/*.png
!references/audit/side-by-side.png
!references/audit/assets-side-by-side.png
# Raw asset downloads for the asset library; only compressed picks in assets/ are committed.
.asset-cache/
!references/audit/arms-side-by-side.png
!references/audit/bare-arms-side-by-side.png
# A person's own earlier run, and screenshots of removed gallery entries and
